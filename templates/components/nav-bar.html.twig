


<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('app_home') }}">Accueil</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <div>
                {% if app.user %}
                    <p class="text-end fst-italic">Bienvenue {{ app.user.email }}</p>
                {% else %}
                    <p class="text-end fst-italic">Utilisateur non connecté</p>
                {% endif %}
            </div>
            <ul class="navbar-nav">
                {% if app.user is same as null %}
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_register') }}">Créer un compte</a>
                    </li>
                
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_login') }}">Connexion</a>
                    </li>
                {% endif %}
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_logout') }}">Déconnexion</a>
                    </li>
                
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_profile') }}">Profil</a>
                    </li>  
                
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_playlists') }}">Playlists</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_favorites') }}">Favoris</a>
                    </li>  
                {% endif %}   
                <li>
                    <a class="nav-link active" aria-current="page" href="{{ path('app_artists') }}">Artistes</a>
                </li>
                {% set genres = getGenres() %}
                <div class="dropdown">
                    <a class="btn btn-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Genres
                    </a>

                    <ul class="dropdown-menu">
                        {% for genre in genres %}
                            <li><a class="dropdown-item" href="{{ path('app_genre', {'id': genre.id}) }}">{{ genre.label }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
                

                  
            </ul>
        </div>
    </div>
</nav>
