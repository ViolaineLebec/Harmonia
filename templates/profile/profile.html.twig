{% extends 'base.html.twig' %}

{% block title %}Profil actif{% endblock %}

{% block body %}
    <h1>
        Bienvenue sur votre espace personnel, {{ app.user.email }}!
    </h1>
    {# <p>
        Votre mot de passe est : {{ app.user.password }}
    </p> #}
    <p>
        Vous êtes inscrit depuis le : {{ app.user.createdAt|date('d/m/Y') }}
    </p>
    <div>
        <p>Vos playlists sont :</p>
        <ul>
            {% for playlist in playlists %}
                <li><a href="{{ path('app_playlist', {'id': playlist.id}) }}">{{ playlist.name }}</a></li>
            {% endfor %}
        </ul>
    </div>
