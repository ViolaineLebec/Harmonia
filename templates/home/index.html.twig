{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
   
    <h2 class="text-center m-3">Les albums</h2>

    <div class="container-fluid bg-secondary">
        <div class="row justify-content-center">
            {% for album in albums %}
                <div class="col-3">
                    {% include 'components/album-card.html.twig' %}
                </div>
            {% endfor %}
        </div>
    </div>

    <h2 class="text-center m-3">Les EPs</h2>

    <div class="container-fluid bg-secondary">
        <div class="row justify-content-center">
            {% for album in EPs %}
                <div class="col-3">
                    {% include 'components/album-card.html.twig' %}
                </div>
            {% endfor %}
        </div>
    </div>

    <h2 class="text-center m-3">Les singles</h2>

    <div class="container-fluid bg-secondary">
        <div class="row justify-content-center">
            {% for album in singles %}
                <div class="col-3">
                    {% include 'components/album-card.html.twig' %}
                </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}
