{% extends 'base.html.twig' %}

{% block title %}Artistes{% endblock %}

{% block body %}
    <h1 class="text-center">Artistes</h1>
    <div class="container-fluid bg-secondary">
        <div class="row justify-content-center m-2 p-2">
            {% for artist in artists %}
                <div class="col-2 m-2">
                    <a class="card" href="{{ path('app_artist', {'id': artist.id}) }}">{{ artist.stageName }}</a>               
                </div>
            {% endfor %}
            <button>
                <a class="card bg-info" href="{{ path('app_artist_add') }}">Ajouter un artiste</a>
            </button>
        </div>
    </div>
{% endblock %}
