{% extends 'base.html.twig' %}

{% block title %}Morceau sélectionné{% endblock %}

{% block body %}

    {# On vérifie au chargement si le track est déjà en favori #}
    {% set isFav = false %}
    {% if app.user %}
        {% set isFav = app.user.favorites|filter(f => f.track == track)|length > 0 %}
    {% endif %}

    
    <button><a href="{{ path('app_album', {'id': track.album.id}) }}" class="text-center">Album</a></button>

    <h2>{{ track.title }}</h2>
    {% if app.user %}
        <button class="btn btn-secondary bouton" data-url='{{ path('app_handle_favorite', {'id': track.id}) }}'>
            {{ isFav ? 'Supprimer ce favori' : 'Ajouter aux favoris' }}
        </button>
    {% endif %}
    
    <h4>Genres :</h4>
    {% for genre in track.genres %}
        <div><a href="{{ path('app_genre', {'id': genre.id}) }}">{{ genre.label }}</a></div>
    {% endfor %}

{% endblock %}
